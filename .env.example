# Set Y after accepting the Service Bus emulator and SQL Server Linux license terms.
ACCEPT_EULA=N
# Replace with a strong local password (uppercase, lowercase, numbers and symbols).
MSSQL_SA_PASSWORD=ReplaceWithYourOwnStrongPassword!123

# Independent secrets, at least 32 bytes each. Generate each with: openssl rand -hex 48
AUTH_SIGNING_KEY=replace-with-independent-random-signing-secret-at-least-32-bytes
AUTH_PHONE_HASH_KEY=replace-with-independent-random-phone-lookup-secret-at-least-32-bytes
