aws_region            = "us-west-2"
state_bucket_names = {
  stg = "cyllio-stg-terraform-state-YOUR_ACCOUNT_ID"
  prd = "cyllio-prd-terraform-state-YOUR_ACCOUNT_ID"
}
github_repository     = "evotch/Cyllio"
create_deployment_policies = true
